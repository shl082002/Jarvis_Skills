#!/usr/bin/env bash
# heimdall — project the workroom to JSON and optionally serve the board.
# Binds 127.0.0.1 only. Not a second tracker.
set -euo pipefail

KIT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PY="$KIT/sidecars/heimdall/project.py"
UI="$KIT/sidecars/heimdall"
PORT="${HEIMDALL_PORT:-3847}"
HOST="127.0.0.1"

usage() {
  echo "usage: heimdall project [workroom] | serve [workroom] | open [workroom]" >&2
  exit 2
}

find_workroom() {
  local start="${1:-}"
  if [[ -n "$start" ]]; then
    echo "$(cd "$start" && pwd)"
    return
  fi
  local d
  d="$(pwd)"
  while [[ "$d" != "/" ]]; do
    if [[ -d "$d/.jarvis" ]]; then
      echo "$d/.jarvis"
      return
    fi
    d="$(dirname "$d")"
  done
  echo "heimdall: no .jarvis workroom found" >&2
  exit 1
}

cmd="${1:-}"
shift || true
[[ -n "$cmd" ]] || usage

WR="$(find_workroom "${1:-}")"

project() {
  python3 "$PY" "$WR" "$KIT"
}

case "$cmd" in
  project)
    project
    ;;
  serve|open)
    STATE="$(project)"
    # Serve the sidecar dir so /index.html and /dist/state.json both resolve.
    echo "heimdall: $HOST:$PORT  (state $STATE)"
    echo "heimdall: bind $HOST only — do not expose"
    if [[ "$cmd" == "open" ]] && command -v open >/dev/null 2>&1; then
      (sleep 0.4; open "http://${HOST}:${PORT}/index.html") &
    fi
    exec python3 - "$UI" "$HOST" "$PORT" <<'PY'
import http.server, socketserver, sys
from functools import partial

root, host, port = sys.argv[1], sys.argv[2], int(sys.argv[3])

class Handler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, fmt, *args):
        sys.stderr.write("heimdall: " + (fmt % args) + "\n")

    def end_headers(self):
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

socketserver.TCPServer.allow_reuse_address = True
httpd = socketserver.TCPServer((host, port), partial(Handler, directory=root))
print("heimdall: listening http://%s:%s/index.html" % (host, port), flush=True)
httpd.serve_forever()
PY
    ;;
  *)
    usage
    ;;
esac
